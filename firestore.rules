rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Client <-> Joseph messages — real enforcement, via the same
    // bridge as everything below. Read/written by two different login
    // types (the client themselves, and admin across any client's
    // thread), scoped by clientEmail rather than clientKey since that's
    // the field these docs actually carry. On create, resource.data
    // doesn't exist yet, so that check reads from request.resource.data
    // instead — same split contacts/quotes already use. ──
    match /messages/{messageId} {
      allow read, update, delete: if request.auth != null
                                   && (request.auth.token.role == 'admin'
                                       || request.auth.token.email == resource.data.clientEmail);
      allow create: if request.auth != null
                    && (request.auth.token.role == 'admin'
                        || request.auth.token.email == request.resource.data.clientEmail);
    }

    // ── Reports (Google Drive links) / Work Completed — client reads
    // their own clientKey subcollection, admin reads+writes any. Client
    // never writes either (confirmed — no setDoc/addDoc for these in
    // portal-dashboard.html), so write is admin-only. ──
    match /reports/{clientKey}/months/{monthId} {
      allow read: if request.auth != null
                  && (request.auth.token.clientKey == clientKey
                      || request.auth.token.role == 'admin');
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }
    match /workcompleted/{clientKey}/months/{monthId} {
      allow read: if request.auth != null
                  && (request.auth.token.clientKey == clientKey
                      || request.auth.token.role == 'admin');
      allow write: if request.auth != null
                   && request.auth.token.role == 'admin';
    }

    // ── Client notification state — doc ID is the client's lowercased
    // email, so ownership is just an equality check against the path
    // itself, same pattern as trainingProgress/{repEmail} below. Only
    // ever read/written by the client themselves (notification bell in
    // portal-dashboard.html) — no admin/rep usage, so no role escape
    // hatch needed here. ──
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == userId;
    }

    // ── CRM contacts/quotes — real enforcement, via the same Netlify ->
    // Firebase custom-token bridge as leads/reps below (mint-firebase-token
    // now also mints a clientKey claim for client logins). A doc's own
    // clientKey field must match the signed-in client's claim; on create
    // that's request.resource.data since the document doesn't exist yet ──
    match /contacts/{contactId} {
      allow read, update, delete: if request.auth != null
                                   && request.auth.token.clientKey == resource.data.clientKey;
      allow create: if request.auth != null
                    && request.auth.token.clientKey == request.resource.data.clientKey;
    }
    match /quotes/{quoteId} {
      allow read, update, delete: if request.auth != null
                                   && request.auth.token.clientKey == resource.data.clientKey;
      allow create: if request.auth != null
                    && request.auth.token.clientKey == request.resource.data.clientKey;
    }

    // ── Outbound mail queue — read by the firestore-send-email extension
    // (Admin SDK, server-side, always bypasses these rules regardless of
    // what's written here). The only client ever writing here is the CRM's
    // review-request "Send" action in portal-dashboard.html. clientKey is
    // an extra field the extension itself doesn't read, added purely so
    // this rule can scope create to the client's own session, same
    // ownership pattern as contacts/quotes above. replyTo is pinned to the
    // sender's own verified login email so a write here can't be made to
    // look like a reply-path to someone else's inbox. No read/update/
    // delete — the client only ever needs to create a send request, never
    // look back at the queue (the extension owns the doc's lifecycle after
    // that, adding its own delivery-status fields). ──
    match /mail/{mailId} {
      allow create: if request.auth != null
                    && request.auth.token.clientKey == request.resource.data.clientKey
                    && request.resource.data.replyTo == request.auth.token.email;
      allow read, update, delete: if false;
    }

    // ── Leads table — real enforcement, via the Netlify -> Firebase
    // custom-token auth bridge (mint-firebase-token) ──
    match /leads/{leadId} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin');

      allow create: if request.auth != null
                    && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin')
                    && request.resource.data.addedByEmail == request.auth.token.email;

      allow update: if request.auth != null
                    && (request.auth.token.role == 'admin'
                        || resource.data.addedByEmail == request.auth.token.email);

      allow delete: if request.auth != null && request.auth.token.role == 'admin';

      match /comments/{commentId} {
        allow read: if request.auth != null
                    && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin');

        allow create: if request.auth != null
                      && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin')
                      && request.resource.data.author == request.auth.token.email;

        allow update, delete: if false;
      }
    }

    // ── Team discussion thread — any rep/admin can read and post ──
    match /teamThread/{monthKey}/messages/{msgId} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin');

      allow create: if request.auth != null
                    && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin')
                    && request.resource.data.authorEmail == request.auth.token.email;

      allow update, delete: if false;
    }

    // ── Private rep <-> Joseph messages ──
    match /repMessages/{msgId} {
      // Reps can only see their own thread; admin sees all
      allow read: if request.auth != null
                  && (request.auth.token.role == 'admin'
                      || resource.data.repEmail == request.auth.token.email);

      allow create: if request.auth != null
                    && (
                      // Rep sending their own message
                      (request.auth.token.role == 'sales_rep' && request.resource.data.repEmail == request.auth.token.email)
                      // Admin replying into any rep's thread
                      || request.auth.token.role == 'admin'
                    );

      allow update, delete: if false;
    }

    // ── Rep training progress — doc ID is the rep's lowercased email,
    // so ownership is just an equality check against the path itself ──
    match /trainingProgress/{repEmail} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'admin'
                      || request.auth.token.email == repEmail);
      allow write: if request.auth != null
                   && (request.auth.token.role == 'admin'
                       || request.auth.token.email == repEmail);
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Existing collections — unchanged from what's currently live ──
    // Left exactly as permissive as before so the client portal keeps
    // working with zero changes. (contacts/quotes/users below now use
    // this same bridge — messages/reports/workcompleted are still open
    // and would need the same treatment, plus their read/write call
    // sites moved to wait for the auth bridge, to tighten further.)
    match /messages/{messageId} {
      allow read, write: if true;
    }
    match /reports/{clientKey}/months/{monthId} {
      allow read, write: if true;
    }
    match /workcompleted/{clientKey}/months/{monthId} {
      allow read, write: if true;
    }

    // ── Client notification state — doc ID is the client's lowercased
    // email, so ownership is just an equality check against the path
    // itself, same pattern as trainingProgress/{repEmail} below. Only
    // ever read/written by the client themselves (notification bell in
    // portal-dashboard.html) — no admin/rep usage, so no role escape
    // hatch needed here. ──
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == userId;
    }

    // ── CRM contacts/quotes — real enforcement, via the same Netlify ->
    // Firebase custom-token bridge as leads/reps below (mint-firebase-token
    // now also mints a clientKey claim for client logins). A doc's own
    // clientKey field must match the signed-in client's claim; on create
    // that's request.resource.data since the document doesn't exist yet ──
    match /contacts/{contactId} {
      allow read, update, delete: if request.auth != null
                                   && request.auth.token.clientKey == resource.data.clientKey;
      allow create: if request.auth != null
                    && request.auth.token.clientKey == request.resource.data.clientKey;
    }
    match /quotes/{quoteId} {
      allow read, update, delete: if request.auth != null
                                   && request.auth.token.clientKey == resource.data.clientKey;
      allow create: if request.auth != null
                    && request.auth.token.clientKey == request.resource.data.clientKey;
    }

    // ── Leads table — real enforcement, via the Netlify -> Firebase
    // custom-token auth bridge (mint-firebase-token) ──
    match /leads/{leadId} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin');

      allow create: if request.auth != null
                    && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin')
                    && request.resource.data.addedByEmail == request.auth.token.email;

      allow update: if request.auth != null
                    && (request.auth.token.role == 'admin'
                        || resource.data.addedByEmail == request.auth.token.email);

      allow delete: if request.auth != null && request.auth.token.role == 'admin';

      match /comments/{commentId} {
        allow read: if request.auth != null
                    && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin');

        allow create: if request.auth != null
                      && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin')
                      && request.resource.data.author == request.auth.token.email;

        allow update, delete: if false;
      }
    }

    // ── Team discussion thread — any rep/admin can read and post ──
    match /teamThread/{monthKey}/messages/{msgId} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin');

      allow create: if request.auth != null
                    && (request.auth.token.role == 'sales_rep' || request.auth.token.role == 'admin')
                    && request.resource.data.authorEmail == request.auth.token.email;

      allow update, delete: if false;
    }

    // ── Private rep <-> Joseph messages ──
    match /repMessages/{msgId} {
      // Reps can only see their own thread; admin sees all
      allow read: if request.auth != null
                  && (request.auth.token.role == 'admin'
                      || resource.data.repEmail == request.auth.token.email);

      allow create: if request.auth != null
                    && (
                      // Rep sending their own message
                      (request.auth.token.role == 'sales_rep' && request.resource.data.repEmail == request.auth.token.email)
                      // Admin replying into any rep's thread
                      || request.auth.token.role == 'admin'
                    );

      allow update, delete: if false;
    }

    // ── Rep training progress — doc ID is the rep's lowercased email,
    // so ownership is just an equality check against the path itself ──
    match /trainingProgress/{repEmail} {
      allow read: if request.auth != null
                  && (request.auth.token.role == 'admin'
                      || request.auth.token.email == repEmail);
      allow write: if request.auth != null
                   && (request.auth.token.role == 'admin'
                       || request.auth.token.email == repEmail);
    }
  }
}
